# Copy to `.env` and fill in. `.env` is gitignored. Real secrets live ONLY here / in the environment.

# --- General ---
APP_ENV=development            # development | production (production hides /docs)
LOG_LEVEL=INFO

# --- PostgreSQL (docker-compose service "db") ---
POSTGRES_USER=promptshield
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=promptshield
# Host is "db" inside docker-compose; use localhost:5432 if running the backend outside Docker.
DATABASE_URL=postgresql+psycopg://promptshield:change-me-db-password@db:5432/promptshield

# --- Web ---
# The only origin CORS will allow (Phase 1 enforces this).
FRONTEND_ORIGIN=http://localhost:3000
# Browser-facing backend URL, baked into the frontend at build time.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- LLM (OpenAI-compatible endpoint; Ollama runs on the HOST, not in compose) ---
# From inside a container the host is reachable as host.docker.internal.
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama             # Ollama ignores the value; set a real key for hosted APIs
LLM_MODEL=qwen2.5:7b-instruct
LLM_TEMPERATURE=0
LLM_SEED=1234

# --- Cookies / limits ---
# Secure cookies work on http://localhost in Chrome/Firefox. Set COOKIE_SECURE=false only for Safari or plain-HTTP LAN testing.
COOKIE_SECURE=true
RATE_LIMIT_ENABLED=true

# --- ML artifacts / exported results (inside the backend container these are mounted from ./ml/artifacts and ./results) ---
# ARTIFACTS_DIR=ml/artifacts
# RESULTS_DIR=results

# --- Auth (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))") ---
JWT_SECRET=change-me-generate-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-admin-password
